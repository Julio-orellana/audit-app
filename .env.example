# Copia este archivo a ".env" (NUNCA subas el .env real a git) y completa
# los valores reales de tu proyecto en Neon (https://neon.tech).
#
# Si dejas este archivo vacío o sin DATABASE_URL, la app usa SQLite local
# automáticamente (ver auditoria_aylupita/settings.py) — no hace falta
# tener Postgres configurado para seguir probando en desarrollo.

# Connection string CON pooler (pgbouncer) — la usa la app en uso normal
# (dashboard, registrar movimientos, reportes, etc.).
DATABASE_URL=postgresql://usuario:password@host-pooler.neon.tech/nombre_bd?sslmode=require

# Connection string DIRECTA, SIN pooler — la usa exclusivamente
# "python manage.py migrate" (Neon recomienda no aplicar migraciones a
# través del pooler). Es la misma base de datos, solo un host distinto
# (normalmente el mismo host sin el sufijo "-pooler").
DIRECT_DATABASE_URL=postgresql://usuario:password@host.neon.tech/nombre_bd?sslmode=require

# Modo debug de Django (prompt 22) — False por defecto si se omite esta
# variable. Actívalo SOLO en tu .env de desarrollo local, nunca en la
# máquina del auditor: con DEBUG=True, un error muestra una página
# técnica con detalles internos del proyecto (nunca contraseñas, Django
# ya las censura, pero sí rutas, configuración y fragmentos de código).
DEBUG=True

# Segundos que la app espera para ESTABLECER una conexión con la nube.
#
# ====================================================================
#  ESTE ES EL VALOR A SUBIR SI UNA LAPTOP RESULTA MÁS LENTA.
#  Se cambia aquí, en el .env que está junto al .exe, y basta con
#  reabrir la app — NO hay que recompilar ni volver a diagnosticar.
# ====================================================================
#
# Por defecto 8 (prompt 33d). Antes era 3 y se quedaba corto: en la VM
# de Windows un handshake real y sano que pasara de 3s se daba por "sin
# conexión", y a partir de ahí TODO login se resolvía contra la caché
# local aunque internet estuviera perfecto. Medido: en Mac el handshake
# completo con Neon (TCP + TLS + autenticación) tarda 0.6s estable y
# 1.9s en frío.
#
# Cómo saber si hay que subirlo: si en diagnostico.log aparece
#
#     SONDEO DE CONECTIVIDAD FALLIDO en X.XXs
#
# CON internet funcionando, este valor se está quedando corto para esa
# red. También avisa antes de fallar, con
#
#     Sondeo de conectividad OK pero lento: X.XXs
#
# Si ese número se acerca al valor de aquí, conviene subirlo.
#
# Ojo con pasarse: este límite es POR DIRECCIÓN IP, y el host de Neon
# resuelve a varias (3 en la VM de Windows), así que detectar un corte
# de red real cuesta (este valor x cantidad de direcciones). Con 8 son
# ~24 segundos en el peor caso, y los paga UN SOLO hilo — los demás
# esperan ese resultado en vez de repetir el intento. Entre 8 y 15 es
# lo razonable; por encima de 20 la app tarda demasiado en darse cuenta
# de que se quedó sin internet.
#DB_CONNECT_TIMEOUT=8
