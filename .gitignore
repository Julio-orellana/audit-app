# Entorno virtual
venv/
env/
.venv/
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Django
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# Cola/catálogo offline local (prompt 19) — datos locales de esta
# máquina (pendientes por sincronizar, catálogo cacheado), nunca se sube
# a git, igual que db.sqlite3.
offline_local.sqlite3
offline_local.sqlite3-journal

# Sesiones en archivo (prompt 19b): SESSION_ENGINE ya no usa la base de
# datos, para que una sesión ya iniciada no se caiga al quedarse sin
# internet. Son archivos locales de esta máquina, nunca se versionan.
sesiones/

# Backups locales de la base de datos (respaldo automático, no versionado)
backups/*
!backups/.gitkeep

# Respaldo completo periódico de la base en la nube (prompt 23) — contiene
# datos reales, nunca se sube a git
backups_completos/*
!backups_completos/.gitkeep

# Salida de PyInstaller (se regenera con build_exe.bat / app.spec)
build/
dist/

# Variables de entorno / secretos
.env
.env.*
!.env.example
# .env.test (prompt 32): base de datos AISLADA de pruebas, cargada
# explícitamente por seguridad_entorno_pruebas.cargar_env_de_pruebas() —
# nunca se sube el archivo real (mismo trato que .env), pero sí su
# plantilla, igual que con .env.example.
!.env.test.example
*.local

# Editores / SO
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

#Archivos
EMPAQUETADO.md
DESARROLLO.md
DIAGNOSTICO_GENERAL.md

.claude/