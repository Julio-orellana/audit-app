# Copia este archivo a ".env.test" (NUNCA subas el .env.test real a git,
# ni tampoco el .env de producción — ambos ya están en .gitignore) y
# completa los valores reales de tu base de datos AISLADA DE PRUEBAS.
#
# ESTE ARCHIVO EXISTE POR EL INCIDENTE DEL PROMPT 30/32: un script
# pensado para correr contra una base de pruebas terminó leyendo el
# .env de producción real (porque nunca se le dijo explícitamente qué
# entorno usar) y borró datos reales. Cualquier script que vaya a
# sembrar datos de prueba o borrar registros masivamente DEBE cargar
# este archivo de forma explícita — nunca el .env de producción, nunca
# "lo que esté activo en ese momento" — usando
# seguridad_entorno_pruebas.cargar_env_de_pruebas() (ver ese módulo
# para el patrón completo).
#
# El nombre de la base de datos DEBE contener "test" (ej. "test_neondb"
# — el mismo nombre que Django genera solo al correr "manage.py test"
# contra una base llamada "neondb", así que ya suele existir) o apuntar
# a localhost/127.0.0.1 (ej. el proxy TCP local usado para simular
# cortes de red) — cargar_env_de_pruebas() rechaza cualquier otra cosa
# como "no tiene pinta de ser de pruebas", sin excepción.

# Misma base física de Neon, pero la base "test_<nombre>" — NUNCA la de
# producción. Confirma con "SELECT current_database();" antes de darla
# por buena si tienes cualquier duda.
DATABASE_URL=postgresql://usuario:password@host-pooler.neon.tech/test_nombre_bd?sslmode=require

DIRECT_DATABASE_URL=postgresql://usuario:password@host.neon.tech/test_nombre_bd?sslmode=require

DEBUG=True
